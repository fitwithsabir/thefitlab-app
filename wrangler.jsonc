// Cloudflare Workers (static assets) — hosts https://thefitlab.in
// Cloudflare publishes this automatically on every push to main.
// html_handling "none" keeps the .html addresses exactly as they were on Netlify;
// _redirects and _headers in fitlab-v7-website work the same way they did there.
{
  "name": "thefitlab",
  "compatibility_date": "2026-10-01",
  // thefitlab.in and www.thefitlab.in point at this Worker (Cloudflare creates the DNS records)
  "routes": [
    { "pattern": "thefitlab.in", "custom_domain": true },
    { "pattern": "www.thefitlab.in", "custom_domain": true }
  ],
  "assets": {
    "directory": "./fitlab-v7-website",
    "html_handling": "none"
  }
}
